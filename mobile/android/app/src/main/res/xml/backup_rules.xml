<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (android:fullBackupContent). The app keeps the
     signed-in session in SharedPreferences and sets android:allowBackup="false",
     so nothing may be copied off the device. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
